generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Enums
 */
enum RoomPrivacy {
  PUBLIC // anyone can find & join (respecting maxParticipants)
  PRIVATE // requires approval / code / password
  INVITE_ONLY // only via invite links or explicit invites
}

enum RoomRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MessageType {
  TEXT
  SYSTEM
  EMOTE
}

enum AssetAction {
  FRONT // the thumbnail/front face shown on select screen (optional: could be only thumbnail)
  IDLE
  WALK_LEFT
  WALK_RIGHT
  WALK_UP
  WALK_DOWN
  JUMP
  // add more actions as needed
}

/**
 * Characters (selectable avatars) — MERGED single model
 */
model Character {
  id             String           @id @default(uuid())
  slug           String           @unique
  name           String
  description    String?
  thumbnailUrl   String?          // front-face/thumbnail used on select screen
  imageUrl       String?          // URL to image/sprite sheet in S3
  meta           Json?            // flexible JSON for sprites, animations, hitbox, costumes etc.
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // relations
  assets         CharacterAsset[]
  userSelections UserCharacter[]
}

/**
 * CharacterAsset / frames
 */
model CharacterAsset {
  id          String           @id @default(uuid())
  characterId String
  character   Character        @relation(fields: [characterId], references: [id])
  action      AssetAction
  createdAt   DateTime         @default(now())
  frames      CharacterFrame[]

  @@unique([characterId, action]) // one asset record per (character, action)
  @@index([characterId, action])
}

model CharacterFrame {
  id      String         @id @default(uuid())
  assetId String
  asset   CharacterAsset @relation(fields: [assetId], references: [id])
  url     String // CDN/S3 URL to a PNG frame (or a data-URL / blob reference)
  order   Int // 0..n-1 ordering for the animation sequence
  width   Int?
  height  Int?
}

/**
 * Users & Auth
 */
model User {
  id            String   @id @default(uuid())
  auth0Id       String?  @unique // e.g. "auth0|123456789"
  email         String?  @unique
  emailVerified Boolean  @default(false)
  username      String?  @unique
  password      String? // optional if using external providers
  displayName   String?
  avatarUrl     String? // user-chosen avatar image (S3/URL)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // relations
  roomsOwned   Room[]          @relation("OwnerRooms")
  selections   UserCharacter[]
  participants Participant[]
  invitesSent  Invitation[]    @relation("Inviter")
  messages     ChatMessage[]
}

/**
 * UserCharacter:
 */
model UserCharacter {
  id             String   @id @default(uuid())
  userId         String
  characterId    String
  isActive       Boolean  @default(false) // is currently selected
  customizations Json? // e.g. color, accessories
  createdAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id])
  character Character @relation(fields: [characterId], references: [id])

  @@index([userId])
  @@index([characterId])
}

/**
 * Map templates
 */
model MapTemplate {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String?
  thumbnailUrl String?
  mapUrl       String? // S3 URL to the actual map data (JSON, TMX, etc)
  width        Int?
  height       Int?
  meta         Json? // navmesh, allowed spawn points, properties
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms Room[]
}

/**
 * Room:
 */
model Room {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  ownerId         String
  mapTemplateId   String
  privacy         RoomPrivacy @default(PUBLIC)
  maxParticipants Int         @default(50)
  isLocked        Boolean     @default(false) // e.g. password-protected
  passwordHash    String? // optional if PRIVATE
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  meta Json?

  owner        User          @relation("OwnerRooms", fields: [ownerId], references: [id])
  mapTemplate  MapTemplate   @relation(fields: [mapTemplateId], references: [id])
  participants Participant[]
  invitations  Invitation[]
  recordings   Recording[]
  messages     ChatMessage[]

  @@index([ownerId])
  @@index([mapTemplateId])
}

/**
 * Participant (room member)
 */
model Participant {
  id             String    @id @default(uuid())
  roomId         String
  userId         String? // null if guest
  displayName    String
  role           RoomRole  @default(MEMBER)
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  lastSeenAt     DateTime?
  position       Json?
  isMuted        Boolean   @default(false)
  isVideoEnabled Boolean   @default(true)
  isSpeaking     Boolean   @default(false)
  peerId         String?
  connectionMeta Json?
  createdAt      DateTime  @default(now())

  room Room  @relation(fields: [roomId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
}

/**
 * Invitation links
 */
model Invitation {
  id           String    @id @default(uuid())
  roomId       String
  inviterId    String? // which user created this invite
  token        String    @unique
  maxUses      Int?
  uses         Int       @default(0)
  expiresAt    DateTime?
  emailAllowed String? // only allow this email if set
  oneTime      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  room    Room  @relation(fields: [roomId], references: [id])
  inviter User? @relation("Inviter", fields: [inviterId], references: [id])

  @@index([roomId])
  @@index([expiresAt])
}

/**
 * Chat messages (room text chat)
 */
model ChatMessage {
  id        String      @id @default(uuid())
  roomId    String
  senderId  String?
  type      MessageType @default(TEXT)
  content   String
  meta      Json?
  createdAt DateTime    @default(now())

  room   Room  @relation(fields: [roomId], references: [id])
  sender User? @relation(fields: [senderId], references: [id])

  @@index([roomId])
  @@index([senderId])
}

/**
 * Recordings
 */
model Recording {
  id          String   @id @default(uuid())
  roomId      String
  s3Key       String
  thumbnailS3 String?
  createdAt   DateTime @default(now())
  duration    Int?
  meta        Json? // e.g. transcriptions, quality, participants at recording time

  room Room @relation(fields: [roomId], references: [id])

  @@index([roomId])
}
